---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { NetworkPage } from "@/components/pages/network-page";
import { sources } from "@/lib/sources";
import { getNetworkStatus, getNodeHealthStatuses } from "@/lib/network";

const [status, nodes] = await Promise.all([getNetworkStatus(), getNodeHealthStatuses()]);
---

<BaseLayout
  title="Network"
  description="Selected public endpoint observations, reported shard data and independent operator aggregate telemetry. Availability is not full network or application readiness."
>
  <NetworkPage client:load status={status} nodes={nodes} publicNode={sources.publicNode} />
</BaseLayout>
