---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { HomePage } from "@/components/pages/home-page";
import { getNetworkStatus, getNodeHealthStatuses } from "@/lib/network";
const [networkStatus, networkNodes] = await Promise.all([getNetworkStatus(), getNodeHealthStatuses()]);
---
<BaseLayout>
  <HomePage networkStatus={networkStatus} networkNodes={networkNodes} />
</BaseLayout>
